# DataPilot Environment Configuration

# App
PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
SECRET_KEY=datapilot_super_secret_jwt_key_change_in_production_32chars
ENCRYPTION_KEY=datapilot_aes256_secret_key_32bytes_long!!

# Database
# Use SQLite locally or PostgreSQL
DATABASE_URL=sqlite:///./datapilot.db
# DATABASE_URL=postgresql://datapilot:datapilot_secret@localhost:5432/datapilot

# Redis (optional for local queue)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Configure at least one)
# Supported: gemini, openai, anthropic
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# File Storage
UPLOAD_DIR=./data/uploads
SANDBOX_DIR=./data/sandboxes
